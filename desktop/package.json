{
  "name": "aster",
  "productName": "Aster",
  "version": "4.0.4",
  "description": "会记住你的桌面伙伴",
  "main": "main.js",
  "author": "Lamore",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.lamore.aster",
    "productName": "Aster",
    "files": [
      "main.js",
      "preload.js",
      "ui/**",
      "engine/**",
      "build/icon.icns",
      "!engine/__pycache__/**",
      "!engine/**/__pycache__/**",
      "!engine/memory/**",
      "!engine/bin/ffmpeg.bak",
      "!ui/audio/_bak*",
      "!ui/index.html",
      "!ui/mobile.html",
      "!ui/_bak-q-20261112/**",
      "!engine/asr_models/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-1024.png"
    },
    "asar": false
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.0.0"
  }
}